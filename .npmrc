legacy-peer-deps=true

# Bootstrap Data design system is published to GitHub Packages (private).
# CI provides NODE_AUTH_TOKEN via the built-in GITHUB_TOKEN (packages: read).
# Locally, export NODE_AUTH_TOKEN=$(gh auth token) before running npm install.
@bootstrapdata:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
